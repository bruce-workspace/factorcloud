# Apply manually to the EKS cluster, one-time per environment:
#   kubectl apply -f help-center-secret.yaml
#
# The real file is .gitignored. Copy this example to `help-center-secret.yaml`,
# fill in real values, then apply. Required only if the app uses the
# help-center auth/middleware flow.

apiVersion: v1
kind: Secret
metadata:
  name: {{K8S_SERVICE_NAME}}-help-center
  namespace: {{K8S_NAMESPACE}}
type: Opaque
stringData:
  password: "REPLACE_ME"
  hmac-secret: "REPLACE_ME_WITH_32_BYTE_HEX"
